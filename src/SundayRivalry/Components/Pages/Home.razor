@inject TimeProvider Clock
@page "/"
@inject GameService Store
@inject DataSync Sync
@inject Microsoft.AspNetCore.Components.Authorization.AuthenticationStateProvider Authentication
@inject NavigationManager Navigation
@inject IConfiguration Configuration
@implements IDisposable
<PageTitle>Sunday Rivalry · Your weekly showdown</PageTitle>
<div class="app-shell">
<aside class="sidebar"><a class="brand" href="/"><span class="brand-icon"><img src="football.svg" alt="" width="48" height="32" /></span><span>Sunday<br /><strong>Rivalry<span class="orange">.</span></strong></span></a><div class="sidebar-label">YOUR HOME FIELD</div><nav><button class="@(tab == "home" && roomId is null ? "active" : "")" @onclick='() => Navigate("home")'><span>▦</span>Overview</button><button class="@(tab == "setup" ? "active" : "")" @onclick='() => Navigate("setup")'><span>⊕</span>New competition</button><button class="@(tab == "history" ? "active" : "")" @onclick='() => Navigate("history")'><span>↺</span>The record book</button><button class="@(tab == "settings" ? "active" : "")" @onclick='() => Navigate("settings")'><span>⚙</span>Data & settings</button></nav><div class="sidebar-bottom"><div class="mini-field"><span></span><span></span><span></span><span></span><i>✦</i></div><strong>Same couch.<br />Different sidelines.</strong><p>Just the two of you.<br />All the bragging rights.</p><span class="local-tag"><i></i>@(signedInOwner.HasValue ? "PRIVATE LEAGUE" : "SHARED DESKTOP")</span></div></aside>
<div class="main-shell"><header class="topbar"><span>YOUR WEEKLY FOOTBALL TRADITION</span><div>@if (signedInOwner.HasValue) { <a class="account-menu" href="/account">My account</a> }<span class="season-tag">@season NFL SEASON</span><div class="couple-avatars"><span>@Initial(state.Names[0])</span><span>@Initial(state.Names[1])</span></div></div></header><main>
@if (roomId is not null && state.Competitions.FirstOrDefault(c => c.Id == roomId) is { } room)
{
    <DraftRoom @key="roomId" C="room" State="state" SignedInOwner="signedInOwner" Back='() => Navigate("home")' />
}
else if (tab == "setup") { <Setup State="state" Created="Open" /> }
else if (tab == "settings")
{
    <div class="page-heading"><div><div class="eyebrow">BEHIND THE SCOREBOARD</div><h1>A league of your own.</h1><p>Make it personal. Keep your football data fresh.</p></div></div>
    <div class="settings-grid"><section class="panel settings-panel"><h2>The home team</h2><p class="muted">Names are saved for new competitions. Existing matchups keep their original names.</p><label>Player one<input @bind="name0" maxlength="30" /></label><label>Player two<input @bind="name1" maxlength="30" /></label><button class="button primary" @onclick="SaveNames">Save names</button><p class="muted">@(signedInOwner.HasValue ? $"Signed in as {state.Names[signedInOwner.Value]}." : "Shared-screen mode: take turns on this desktop. Each action identifies its participant.")</p>@if (signedInOwner.HasValue) { <p><a class="button secondary" href="/account">Account, invitation &amp; password →</a></p><form method="post" action="/logout"><AntiforgeryToken /><button class="text-button">Sign out</button></form> }</section>
    <section class="panel settings-panel"><div class="section-heading"><h2>Fresh from the field</h2><span class="pill">NFLVERSE</span></div><p>@state.SyncMessage</p><div class="data-stats"><div><strong>@state.Players.Count</strong><small>players & defenses</small></div><div><strong>@state.Stats.Count.ToString("N0")</strong><small>stat records</small></div><div><strong>@state.Games.Count</strong><small>scheduled games</small></div></div><label>Import season<input type="number" min="2020" max="2100" @bind="syncSeason" /></label><button class="button primary" disabled="@(syncing || Sync.Busy)" @onclick="SyncNow">@(syncing || Sync.Busy ? "Syncing NFL data…" : "↻ Sync NFL data")</button><p class="muted">Last successful import: @(state.LastSync is null ? "Not yet" : Eastern(state.LastSync.Value).ToString("MMM d, yyyy · h:mm tt") + " ET")</p><small>Schedules and rosters are cached locally. New competitions use matching imported FanDuel projections when available. Other estimates use up to five previous appearances or a position baseline. Statistics are delayed and refresh periodically while the app runs.</small><p><a href="https://nflreadr.nflverse.com/articles/nflverse_data_schedule.html" target="_blank" rel="noreferrer">About the data source ↗</a></p></section>
    <LiveFeedPanel State="state" />
    <ProjectionImportPanel State="state" />
    <EspnProjectionPanel State="state" />
    <section class="panel settings-panel scoring-reference"><h2>The scoring playbook</h2><p>Choose full PPR, half PPR, or standard for each competition. All other rules stay consistent.</p><div class="scoring-grid"><div><strong>Offense</strong><p>Passing: 1 point / 25 yards, 4 / TD, −2 / interception.<br />Rushing & receiving: 1 / 10 yards, 6 / TD.<br />Receptions: 1, 0.5, or 0 by preset.<br />Fumbles lost: −2. Two-point conversions: 2. Return TD: 6.</p></div><div><strong>Kickers</strong><p>Extra point: 1.<br />Field goal under 40 yards: 3.<br />40–49 yards: 4. 50+ yards: 5.<br />No missed-kick penalty.</p></div><div><strong>Team defense / special teams</strong><p>Sack: 1. Takeaway, safety, blocked kick: 2.<br />Defensive or special-teams TD: 6.<br />Points allowed: 0 → 10; 1–6 → 7; 7–13 → 4; 14–20 → 1; 21–27 → 0; 28–34 → −1; 35+ → −4.<br />Uses the full opponent scoreboard total.</p></div></div></section></div>
}
else if (tab == "history")
{
    <div class="page-heading"><div><div class="eyebrow">FOR THE BRAGGING RIGHTS</div><h1>The record book.</h1><p>Every week is a fresh start. The memories stick around.</p></div><button class="button primary" @onclick='() => Navigate("setup")'>New competition +</button></div>
    @CompetitionList(state.Competitions.OrderByDescending(c => c.CreatedAt).ToList())
}
else
{
    <div class="page-heading"><div><div class="eyebrow">WELCOME TO YOUR HOME FIELD</div><h1>A little friendly rivalry<span class="orange">.</span></h1><p>A fresh lineup. A new showdown. Your kind of football.</p></div><button class="button primary" @onclick='() => Navigate("setup")'>New competition <span>+</span></button></div>
    <section class="hero"><div class="hero-copy"><span class="hero-kicker"><i></i> TWO TEAMS. ALL THE BRAGGING RIGHTS.</span><h2>Sundays are better<br />with a rival.</h2><p>Build your dream team, go head-to-head,<br class="desktop-break" /> and give the weekend a little extra meaning.</p><div class="hero-actions"><button class="button cream" @onclick='() => Navigate("setup")'>Set up this week's game →</button><button class="hero-link" disabled="@creating" @onclick='() => Practice("Snake")'>Try a practice draft ↗</button></div></div><div class="field-art" aria-hidden="true"><div class="field-boundary"><div class="field-lines"></div><span class="yard yard1">20</span><span class="yard yard2">30</span><span class="yard yard3">40</span><div class="play-route route-one"></div><div class="play-route route-two"></div><span class="x x1">×</span><span class="x x2">×</span><span class="x x3">×</span><span class="o o1">○</span><span class="o o2">○</span><span class="o o3">○</span><img class="football" src="football.svg" alt="" width="240" height="160" /></div><div class="field-sticker">EST. THIS SUNDAY<br /><strong>YOU vs. YOUR FAVORITE RIVAL</strong></div></div></section>
    <div class="stat-cards"><div class="panel stat-card"><span class="stat-icon">⚑</span><div><small>THE HEAD-TO-HEAD</small><strong>@Wins(0) <span>–</span> @Wins(1)</strong><p>@state.Names[0] vs. @state.Names[1]</p></div></div><div class="panel stat-card"><span class="stat-icon orange-icon">▤</span><div><small>WEEKS IN THE BOOKS</small><strong>@state.Competitions.Count(c => GameService.Final(state, c))</strong><p>@Ties ties · plenty of stories to come</p></div></div><div class="panel stat-card"><span class="stat-icon">↝</span><div><small>YOUR NEXT FIRST PICK</small><strong class="name-stat">@state.Names[state.Competitions.Count(c => !c.Demo && c.Format == "Snake") % 2]</strong><p>A new week. A fair shot.</p></div></div></div>
    <div class="dashboard-columns"><section><div class="section-heading outside"><h2>Your competitions</h2><button class="text-button" @onclick='() => Navigate("history")'>View all →</button></div>@CompetitionList(state.Competitions.OrderByDescending(c => c.CreatedAt).Take(3).ToList())</section><section class="panel weekend-panel"><div class="section-heading"><h2>On the schedule</h2><span class="pill">WEEK @week</span></div><p class="muted">Your next NFL matchups · Eastern Time</p>@if (Upcoming.Count == 0) { <div class="empty compact"><h3>The field is getting ready.</h3><p>Import the NFL schedule to see upcoming games.</p><button class="button secondary" disabled="@syncing" @onclick="SyncNow">@(syncing ? "Syncing…" : "Sync NFL data")</button></div> }@foreach (var g in Upcoming.Take(4)) { <div class="schedule-row"><div class="schedule-day"><strong>@Eastern(g.Kickoff).ToString("ddd").ToUpper()</strong><small>@Eastern(g.Kickoff).ToString("h:mm tt")</small></div><div><strong>@g.Away <span class="muted">at</span> @g.Home</strong><small>@g.Stadium</small></div><span class="schedule-arrow">↗</span></div> }<div class="schedule-note"><i></i>Cached schedule · choose any available slate</div></section></div>
    <div class="practice-strip"><span class="practice-icon">✦</span><div><strong>Find your drafting rhythm.</strong><p>Take a test drive with fictional players. No pressure. Just practice.</p></div><button class="text-button" disabled="@creating" @onclick='() => Practice("Salary")'>Try salary cap →</button></div>
}
</main><footer><a class="footer-brand" href="/">Sunday Rivalry<span class="orange">.</span></a><span>Built for two. Played for fun.</span><span class="footer-data">@(state.LastSync is null ? "Awaiting first data sync" : "Delayed stats · " + Eastern(state.LastSync.Value).ToString("MMM d, h:mm tt") + " ET")</span></footer></div></div>
@if (message != "") { <div class="toast" role="status">@message<button aria-label="Dismiss message" @onclick='() => message = ""'>×</button></div> }
@code {
    AppState state = new(); string tab = "home"; string? roomId; string name0 = "", name1 = "", message = ""; int season, week, syncSeason; bool syncing, creating; int? signedInOwner;
    List<NflGame> Upcoming => state.Games.Where(g => g.Kickoff > Clock.GetUtcNow()).OrderBy(g => g.Kickoff).ToList();
    protected override async Task OnInitializedAsync() { Store.Changed += OnChanged; Authentication.AuthenticationStateChanged += OnAuthenticationChanged; Refresh(); name0 = state.Names[0]; name1 = state.Names[1]; syncSeason = season; var auth = await Authentication.GetAuthenticationStateAsync(); if (int.TryParse(auth.User.FindFirst("player_slot")?.Value, out var owner)) signedInOwner = owner; }
    void Refresh() { state = Store.Snapshot(); var next = Upcoming.FirstOrDefault(); season = next?.Season ?? Clock.GetUtcNow().Year; week = next?.Week ?? 1; }
    void OnChanged() => _ = InvokeAsync(() => { Refresh(); StateHasChanged(); });
    async void OnAuthenticationChanged(Task<Microsoft.AspNetCore.Components.Authorization.AuthenticationState> pending)
    {
        var authentication = await pending;
        await InvokeAsync(() =>
        {
            if (authentication.User.Identity?.IsAuthenticated != true && Configuration.GetValue("Auth:Enabled", true))
                Navigation.NavigateTo("/login", forceLoad: true);
        });
    }
    void Navigate(string to) { roomId = null; tab = to; }
    void Open(string id) { roomId = id; tab = "home"; }
    async Task Practice(string format) { creating = true; try { var id = await Store.Create(Clock.GetUtcNow().Year, 1, format, 1, 200, format == "Snake" ? "The practice draft" : "The budget playbook", [], true); Open(id); } catch (Exception ex) { message = ex.Message; } finally { creating = false; } }
    async Task SyncNow() { syncing = true; try { await Sync.Sync(syncSeason == 0 ? season : syncSeason); Refresh(); message = state.SyncMessage; } finally { syncing = false; } }
    async Task SaveNames() { if (string.IsNullOrWhiteSpace(name0) || string.IsNullOrWhiteSpace(name1)) { message = "Give both players a name first."; return; } await Store.Mutate(s => s.Names = [name0.Trim()[..Math.Min(30, name0.Trim().Length)], name1.Trim()[..Math.Min(30, name1.Trim().Length)]]); message = "Names saved. Your next competition will use them."; }
    int Wins(int owner) => state.Competitions.Count(c => GameService.Final(state, c) && GameService.Total(state, c, owner, false) > GameService.Total(state, c, 1 - owner, false));
    int Ties => state.Competitions.Count(c => GameService.Final(state, c) && Math.Abs(GameService.Total(state, c, 0, false) - GameService.Total(state, c, 1, false)) < .0001);
    string Initial(string name) => string.IsNullOrWhiteSpace(name) ? "?" : name[..1].ToUpper();
    static DateTime Eastern(DateTimeOffset x) => TimeZoneInfo.ConvertTime(x, TimeZoneInfo.FindSystemTimeZoneById("America/New_York")).DateTime;
    RenderFragment CompetitionList(List<Competition> competitions) => @<div class="competition-list">@if (competitions.Count == 0) { <div class="panel empty competition-empty"><span class="empty-flag">⚑</span><h3>Your rivalry starts here.</h3><p>No matchups yet. Start a weekly competition<br />and make your first picks together.</p><button class="button secondary" @onclick='() => Navigate("setup")'>Create your first competition →</button></div> }@foreach (var c in competitions) { var final = GameService.Final(state, c); <button class="panel competition-card" @onclick="() => Open(c.Id)"><div class="competition-icon">@(c.Format == "Snake" ? "↝" : "◈")</div><div class="competition-info"><span class="eyebrow">@(c.Demo ? "PRACTICE" : $"{c.Season} · WEEK {c.Week}") · @Rules.ScoringName(c.Ppr).ToUpper()</span><h3>@c.Title</h3><p>@c.Format @(c.Format == "Salary" ? "cap" : "draft") · @c.Games.Count games · @c.Picks.Count / 18 selected</p></div><div class="competition-status"><span class="pill @(final ? "final" : "")">@(final ? "Final" : c.Locked ? "Locked" : c.Started ? "In progress" : "Lobby")</span><small>@(final ? $"{GameService.Total(state, c, 0, false):0.0} – {GameService.Total(state, c, 1, false):0.0}" : "Open room →")</small></div></button> }</div>;
    public void Dispose() { Store.Changed -= OnChanged; Authentication.AuthenticationStateChanged -= OnAuthenticationChanged; }
}
